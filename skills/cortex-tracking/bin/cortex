#!/usr/bin/env bash
# cortex: unified front door for the cortex-tracking skill family.
# Dispatches to the cortex engine (kb, viz, query, inject, sync, migrate-store).
# See skills/*/SKILL.md.
set -euo pipefail

usage() {
    cat >&2 <<'EOF'
Usage:
  cortex kb    <command> [args...]  Author/query knowledge & workbench docs
                                     (new, update, index, ingest, lint)
  cortex viz   <command> [args...]  Visualize the work tree (build, serve)
  cortex query  <command> [args...]  Query the work graph (neighbors)
  cortex inject <command> [args...]  Opt-in session-start injection
                                     (enable, disable, status, here)
  cortex sync  <command> [args...]  Sync the ~/.cortex store to a private repo
                                     (push, pull, setup, status)
  cortex migrate-store [--write]    Move the store from ~/.work to ~/.cortex

Run `cortex kb --help`, `cortex viz --help`, `cortex query --help`, or
`cortex inject --help` for group-specific help.
EOF
    exit "${1:-2}"
}

# Portable realpath: resolve symlinks without readlink -f (BSD/macOS lacks it).
_resolve() {
    local p="$1" t
    while [ -L "$p" ]; do
        t="$(readlink "$p")"
        case "$t" in
            /*) p="$t" ;;
            *)  p="$(cd "$(dirname "$p")" && cd "$(dirname "$t")" && pwd)/$(basename "$t")" ;;
        esac
    done
    printf '%s' "$p"
}

self="$0"
case "$self" in
    */*) : ;;
    *)   self="$(command -v -- "$self")" ;;
esac
self="$(_resolve "$self")"
# bin/ -> cortex-tracking/ -> skills/ -> repo root
# Physical resolution (-P) so an invocation through a symlinked skill dir still
# lands at the real repo root, where the top-level `cortex/` package lives.
REPO_ROOT="$(cd -P "$(dirname "$self")/../../.." && pwd -P)"

[[ $# -ge 1 ]] || usage
group="$1"; shift
case "$group" in
    kb|viz|query|inject|sync|migrate-store) [[ -f "$REPO_ROOT/cortex/cli.py" ]] || {
                   echo "cortex: cannot find the cortex engine at $REPO_ROOT/cortex (broken install?)" >&2
                   exit 1
               }
               exec env PYTHONPATH="$REPO_ROOT${PYTHONPATH:+:$PYTHONPATH}" \
                    "${CORTEX_PYTHON:-python3}" -m cortex.cli "$group" "$@" ;;
    -h|--help) usage 0 ;;
    *) echo "cortex: unknown command '$group'" >&2; usage ;;
esac
