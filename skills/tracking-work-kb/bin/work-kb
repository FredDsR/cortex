#!/usr/bin/env bash
# work-kb: create knowledge / workbench markdown files in ~/.work or <repo>/.work.
# Agent-primary CLI. Spec B (kb write paths). See SKILL.md for full surface.
set -euo pipefail

WORK_KB_AUTHOR_DEFAULT="agent"

die() { echo "error: $*" >&2; exit "${2:-1}"; }
usage() {
    cat >&2 <<EOF
Usage:
  work-kb new knowledge <slug> [--workspace <ws>] [--author <human|agent>]
                                [--body <text>] [--body-from <file|->]
                                [--open]
  work-kb new workbench <slug> [--session <sess>] [--workspace <ws>] [--author ...]
                                [--body ...] [--body-from ...] [--open]
  work-kb update knowledge <slug> [same flags as: new knowledge]
  work-kb update workbench <slug> [same flags as: new workbench]
  work-kb index [--workspace <ws>] [--session <sess>] [--max <N>] [--write]

Flags (new / update): --title <text> --type <text> --description <text>
EOF
    exit 2
}

validate_slug() {
    local s="$1"
    [[ "$s" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid slug: '$s' (must match [a-z0-9][a-z0-9-]*)"
}

today() { date +%Y-%m-%d; }

# Populate flag globals from an argument list. Tracks which optional flags were
# explicitly passed via *_SET so callers can distinguish "" from "unset".
parse_flags() {
    SLUG=""; WS_FLAG=""; SESS_FLAG=""; AUTHOR_FLAG=""
    TITLE_FLAG=""; TYPE_FLAG=""; DESC_FLAG=""
    BODY_TEXT=""; BODY_FROM=""; OPEN_FLAG=0
    TITLE_SET=0; TYPE_SET=0; DESC_SET=0; AUTHOR_SET=0; BODY_SET=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --workspace)   WS_FLAG="$2"; shift 2 ;;
            --session)     SESS_FLAG="$2"; shift 2 ;;
            --author)      AUTHOR_FLAG="$2"; AUTHOR_SET=1; shift 2 ;;
            --title)       TITLE_FLAG="$2"; TITLE_SET=1; shift 2 ;;
            --type)        TYPE_FLAG="$2"; TYPE_SET=1; shift 2 ;;
            --description) DESC_FLAG="$2"; DESC_SET=1; shift 2 ;;
            --body)        BODY_TEXT="$2"; BODY_SET=1; shift 2 ;;
            --body-from)   BODY_FROM="$2"; BODY_SET=1; shift 2 ;;
            --open)        OPEN_FLAG=1; shift ;;
            --) shift; break ;;
            -*) die "unknown flag: $1" 2 ;;
            *) [[ -z "$SLUG" ]] && SLUG="$1" || die "extra argument: $1" 2; shift ;;
        esac
    done
}

resolve_author() {
    local a="$AUTHOR_FLAG"
    if (( ! AUTHOR_SET )); then
        if (( OPEN_FLAG )); then a="human"; else a="$WORK_KB_AUTHOR_DEFAULT"; fi
    fi
    [[ "$a" == "human" || "$a" == "agent" ]] || die "author must be 'human' or 'agent'"
    printf '%s' "$a"
}

# Resolve the target file path into the RESOLVED_PATH global. Called as a plain
# command (not in a command substitution) so a die() inside resolve_workspace /
# resolve_session aborts the whole invocation via set -e, rather than being
# swallowed by an enclosing $(...) subshell.
resolve_path() {
    local kind="$1" ws_root sess
    ws_root="$(resolve_workspace "$WS_FLAG")"
    if [[ "$kind" == "knowledge" ]]; then
        RESOLVED_PATH="$ws_root/knowledge/$SLUG.md"
    else
        sess="$(resolve_session "$ws_root" "$SESS_FLAG")"
        RESOLVED_PATH="$ws_root/sessions/$sess/workbench/$SLUG.md"
    fi
}

# Writes a doc from F_* globals in deterministic field order; prints the path.
emit_doc() {
    local path="$1"
    mkdir -p "$(dirname "$path")"
    {
        printf '%s\n' '---'
        [[ -n "$F_TITLE" ]] && printf 'title: %s\n' "$F_TITLE"
        [[ -n "$F_TYPE" ]] && printf 'type: %s\n' "$F_TYPE"
        printf 'author: %s\n' "$F_AUTHOR"
        printf 'created: %s\n' "$F_CREATED"
        printf 'updated: %s\n' "$F_UPDATED"
        [[ -n "$F_DESC" ]] && printf 'description: %s\n' "$F_DESC"
        printf '%s\n' '---'
        printf '\n'
        printf '%s' "$F_BODY"
    } > "$path"
    printf '%s\n' "$path"
}

sync_after() {
    local verb="$1" kind="$2" slug="$3"
    local sync_script="$HOME/.claude/skills/tracking-work-sync/scripts/commit_push.sh"
    if [[ -x "$sync_script" ]]; then
        bash "$sync_script" "track(kb): $verb $kind $slug" >/dev/null 2>&1 || true
    fi
}

# Split a file into its leading YAML frontmatter block and body.
# Sets FM_BLOCK (fence-exclusive frontmatter lines) and FM_BODY (body with the
# single emitter-inserted blank separator stripped). Returns 1 if there is no
# well-formed leading "---\n...\n---" block.
split_fm() {
    local file="$1" close
    [[ "$(head -n1 "$file")" == "---" ]] || return 1
    close="$(awk 'NR>1 && $0=="---"{print NR; exit}' "$file")"
    [[ -n "$close" ]] || return 1
    FM_BLOCK="$(sed -n "2,$((close-1))p" "$file")"
    FM_BODY="$(sed -n "$((close+1)),\$p" "$file")"
    FM_BODY="${FM_BODY#$'\n'}"   # drop the one blank line emit_doc inserts
}

# Print the scalar value of KEY from FM_BLOCK (empty if absent). Reads only
# "key: value" lines; structured/unknown keys are ignored, never misparsed.
fm_field() {
    printf '%s\n' "$FM_BLOCK" | sed -n "s/^$1: \{0,1\}//p" | head -n1
}

# Walk up from cwd looking for nearest ancestor with .work/. Only searches
# within $HOME; refuses to walk outside (e.g., into /var or /tmp) where a
# stray .work/ would not be the user's intended local store.
find_local_store() {
    local d
    d="$(pwd -P)"
    # Require cwd to be inside $HOME (resolved). If not, no local store.
    local home_real
    home_real="$(cd "$HOME" 2>/dev/null && pwd -P)" || return 1
    case "$d/" in
        "$home_real"/*) : ;;
        "$home_real/") return 1 ;;  # cwd == $HOME: no ancestor to search
        *) return 1 ;;
    esac
    while [[ "$d" != "/" && "$d" != "$home_real" ]]; do
        if [[ -d "$d/.work" ]]; then echo "$d/.work"; return 0; fi
        d="$(dirname "$d")"
    done
    return 1
}

resolve_workspace() {
    local explicit_ws="$1"
    if [[ -n "$explicit_ws" ]]; then
        local global="$HOME/.work/workspaces/$explicit_ws"
        [[ -d "$global" ]] || die "workspace '$explicit_ws' not found"
        echo "$global"; return 0
    fi
    local local_root
    if local_root="$(find_local_store 2>/dev/null)"; then
        echo "$local_root"; return 0
    fi
    # Global scan: find workspaces with any .active.* pointer.
    local matches=()
    if [[ -d "$HOME/.work/workspaces" ]]; then
        while IFS= read -r -d '' ws; do
            shopt -s nullglob
            local actives=("$ws"/.active.*)
            shopt -u nullglob
            if (( ${#actives[@]} > 0 )); then
                matches+=("$ws")
            fi
        done < <(find "$HOME/.work/workspaces" -mindepth 1 -maxdepth 1 -type d -print0)
    fi
    case "${#matches[@]}" in
        0) die "no workspace context; pass --workspace <ws>" ;;
        1) echo "${matches[0]}" ;;
        *)
            local names=()
            for m in "${matches[@]}"; do names+=("$(basename "$m")"); done
            die "multiple active workspaces (${names[*]}); pass --workspace <ws>"
            ;;
    esac
}

resolve_session() {
    local ws_root="$1" explicit_sess="$2"
    if [[ -n "$explicit_sess" ]]; then
        [[ -d "$ws_root/sessions/$explicit_sess" ]] || \
            die "session '$explicit_sess' not found in workspace '$(basename "$ws_root")'"
        echo "$explicit_sess"; return 0
    fi
    local sessions=()
    shopt -s nullglob
    for f in "$ws_root"/.active.*; do
        sessions+=("$(cat "$f")")
    done
    shopt -u nullglob
    if (( ${#sessions[@]} == 0 )); then
        die "no active session in '$(basename "$ws_root")'; pass --session <sess>"
    fi
    local unique
    unique="$(printf '%s\n' "${sessions[@]}" | sort -u)"
    local count
    count="$(printf '%s\n' "$unique" | wc -l)"
    if (( count == 1 )); then
        printf '%s' "$unique"
    else
        die "multiple sessions active in '$(basename "$ws_root")'; pass --session <sess>"
    fi
}

read_body() {
    local body_text="$1" body_from="$2"
    if [[ -n "$body_text" ]]; then printf '%s' "$body_text"; return 0; fi
    if [[ -n "$body_from" ]]; then
        if [[ "$body_from" == "-" ]]; then cat; else cat "$body_from"; fi
        return 0
    fi
    if [[ ! -t 0 ]]; then cat; return 0; fi
    printf ''
}

cmd_new() {
    local kind="$1"; shift
    [[ "$kind" == "knowledge" || "$kind" == "workbench" ]] || \
        die "kind must be 'knowledge' or 'workbench'" 2
    parse_flags "$@"
    [[ -n "$SLUG" ]] || usage
    validate_slug "$SLUG"

    F_AUTHOR="$(resolve_author)"
    local path
    resolve_path "$kind"; path="$RESOLVED_PATH"
    [[ -f "$path" ]] && die "$path already exists"

    F_TITLE="$TITLE_FLAG"; F_TYPE="$TYPE_FLAG"; F_DESC="$DESC_FLAG"
    F_CREATED="$(today)"; F_UPDATED="$F_CREATED"
    F_BODY="$(read_body "$BODY_TEXT" "$BODY_FROM")"

    emit_doc "$path"
    sync_after "new" "$kind" "$SLUG"

    if (( OPEN_FLAG )); then exec "${EDITOR:-vi}" "$path"; fi
}

cmd_update() {
    local kind="$1"; shift
    [[ "$kind" == "knowledge" || "$kind" == "workbench" ]] || \
        die "kind must be 'knowledge' or 'workbench'" 2
    parse_flags "$@"
    [[ -n "$SLUG" ]] || usage
    validate_slug "$SLUG"

    local path
    resolve_path "$kind"; path="$RESOLVED_PATH"
    [[ -f "$path" ]] || die "$path not found"
    split_fm "$path" || die "$path has malformed frontmatter"

    local ex_title ex_type ex_desc ex_author ex_created
    ex_title="$(fm_field title)"; ex_type="$(fm_field type)"
    ex_desc="$(fm_field description)"; ex_author="$(fm_field author)"
    ex_created="$(fm_field created)"

    if (( TITLE_SET )); then F_TITLE="$TITLE_FLAG"; else F_TITLE="$ex_title"; fi
    if (( TYPE_SET )); then F_TYPE="$TYPE_FLAG"; else F_TYPE="$ex_type"; fi
    if (( DESC_SET )); then F_DESC="$DESC_FLAG"; else F_DESC="$ex_desc"; fi
    if (( AUTHOR_SET )); then
        [[ "$AUTHOR_FLAG" == "human" || "$AUTHOR_FLAG" == "agent" ]] || \
            die "author must be 'human' or 'agent'"
        F_AUTHOR="$AUTHOR_FLAG"
    else
        F_AUTHOR="${ex_author:-$WORK_KB_AUTHOR_DEFAULT}"
    fi
    F_CREATED="${ex_created:-$(today)}"
    F_UPDATED="$(today)"

    # update replaces the body only when a body source is explicitly given;
    # bare stdin is NOT auto-consumed here (that would break the pure-touch case).
    if (( BODY_SET )); then
        F_BODY="$(read_body "$BODY_TEXT" "$BODY_FROM")"
    else
        F_BODY="$FM_BODY"
    fi

    emit_doc "$path"
    sync_after "update" "$kind" "$SLUG"

    if (( OPEN_FLAG )); then exec "${EDITOR:-vi}" "$path"; fi
}

[[ $# -ge 1 ]] || usage
case "$1" in
    new)    shift; [[ $# -ge 1 ]] || usage; cmd_new "$@" ;;
    update) shift; [[ $# -ge 1 ]] || usage; cmd_update "$@" ;;
    -h|--help) usage ;;
    *) die "unknown subcommand: $1" 2 ;;
esac
