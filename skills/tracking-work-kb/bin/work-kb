#!/usr/bin/env bash
# work-kb: create knowledge / workbench markdown files in ~/.work or <repo>/.work.
# Agent-primary CLI. Spec B (kb write paths). See SKILL.md for full surface.
set -euo pipefail

WORK_KB_AUTHOR_DEFAULT="agent"
KB_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib"

die() { echo "error: $*" >&2; exit "${2:-1}"; }
usage() {
    cat >&2 <<EOF
Usage:
  work-kb new knowledge <slug> [--workspace <ws>] [--author <human|agent>]
                                [--body <text>] [--body-from <file|->]
                                [--open]
  work-kb new workbench <slug> [--session <sess>] [--workspace <ws>] [--author ...]
                                [--body ...] [--body-from ...] [--open]
  work-kb update knowledge <slug> [same flags as: new knowledge]
  work-kb update workbench <slug> [same flags as: new workbench]
  work-kb index [--workspace <ws>] [--session <sess>] [--max <N>] [--write]
  work-kb ingest [--from <src>] [--workspace <dest>] [--write] [--only openapi|sql] [--max <N>]

Flags (new / update): --title <text> --type <text> --description <text>
EOF
    exit 2
}

validate_slug() {
    local s="$1"
    [[ "$s" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid slug: '$s' (must match [a-z0-9][a-z0-9-]*)"
}

today() { date +%Y-%m-%d; }

# Populate flag globals from an argument list. Tracks which optional flags were
# explicitly passed via *_SET so callers can distinguish "" from "unset".
parse_flags() {
    SLUG=""; WS_FLAG=""; SESS_FLAG=""; AUTHOR_FLAG=""
    TITLE_FLAG=""; TYPE_FLAG=""; DESC_FLAG=""
    BODY_TEXT=""; BODY_FROM=""; OPEN_FLAG=0
    TITLE_SET=0; TYPE_SET=0; DESC_SET=0; AUTHOR_SET=0; BODY_SET=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --workspace)   WS_FLAG="$2"; shift 2 ;;
            --session)     SESS_FLAG="$2"; shift 2 ;;
            --author)      AUTHOR_FLAG="$2"; AUTHOR_SET=1; shift 2 ;;
            --title)       TITLE_FLAG="$2"; TITLE_SET=1; shift 2 ;;
            --type)        TYPE_FLAG="$2"; TYPE_SET=1; shift 2 ;;
            --description) DESC_FLAG="$2"; DESC_SET=1; shift 2 ;;
            --body)        BODY_TEXT="$2"; BODY_SET=1; shift 2 ;;
            --body-from)   BODY_FROM="$2"; BODY_SET=1; shift 2 ;;
            --open)        OPEN_FLAG=1; shift ;;
            --) shift; break ;;
            -*) die "unknown flag: $1" 2 ;;
            *) [[ -z "$SLUG" ]] && SLUG="$1" || die "extra argument: $1" 2; shift ;;
        esac
    done
}

resolve_author() {
    local a="$AUTHOR_FLAG"
    if (( ! AUTHOR_SET )); then
        if (( OPEN_FLAG )); then a="human"; else a="$WORK_KB_AUTHOR_DEFAULT"; fi
    fi
    [[ "$a" == "human" || "$a" == "agent" ]] || die "author must be 'human' or 'agent'"
    printf '%s' "$a"
}

# Resolve the target file path into the RESOLVED_PATH global. Called as a plain
# command (not in a command substitution) so a die() inside resolve_workspace /
# resolve_session aborts the whole invocation via set -e, rather than being
# swallowed by an enclosing $(...) subshell.
resolve_path() {
    local kind="$1" ws_root sess
    ws_root="$(resolve_workspace "$WS_FLAG")"
    if [[ "$kind" == "knowledge" ]]; then
        RESOLVED_PATH="$ws_root/knowledge/$SLUG.md"
    else
        sess="$(resolve_session "$ws_root" "$SESS_FLAG")"
        RESOLVED_PATH="$ws_root/sessions/$sess/workbench/$SLUG.md"
    fi
}

# Writes a doc from F_* globals in deterministic field order; prints the path.
# Render a value as a safe YAML scalar. Plain when it starts with an
# alphanumeric and uses only an unambiguous allowlist (keeps human-authored
# values readable, e.g. `title: A decision`); double-quoted with \ and "
# escaped otherwise (e.g. an ingested API summary `Create order: v2` ->
# `"Create order: v2"`). fm_field() is its inverse.
_yaml_scalar() {
    local v="$1" safe='^[A-Za-z0-9][A-Za-z0-9_./() -]*$'
    if [[ -n "$v" && "$v" =~ $safe ]]; then
        printf '%s' "$v"
    else
        v="${v//\\/\\\\}"; v="${v//\"/\\\"}"
        printf '"%s"' "$v"
    fi
}

emit_doc() {
    local path="$1"
    mkdir -p "$(dirname "$path")"
    {
        printf '%s\n' '---'
        [[ -n "$F_TITLE" ]] && printf 'title: %s\n' "$(_yaml_scalar "$F_TITLE")"
        [[ -n "$F_TYPE" ]] && printf 'type: %s\n' "$(_yaml_scalar "$F_TYPE")"
        printf 'author: %s\n' "$F_AUTHOR"
        printf 'created: %s\n' "$F_CREATED"
        printf 'updated: %s\n' "$F_UPDATED"
        [[ -n "$F_DESC" ]] && printf 'description: %s\n' "$(_yaml_scalar "$F_DESC")"
        printf '%s\n' '---'
        printf '\n'
        printf '%s' "$F_BODY"
    } > "$path"
    printf '%s\n' "$path"
}

sync_after() {
    local verb="$1" kind="$2" slug="$3"
    local sync_script="$HOME/.claude/skills/tracking-work-sync/scripts/commit_push.sh"
    if [[ -x "$sync_script" ]]; then
        bash "$sync_script" "track(kb): $verb $kind $slug" >/dev/null 2>&1 || true
    fi
}

# Split a file into its leading YAML frontmatter block and body.
# Sets FM_BLOCK (fence-exclusive frontmatter lines) and FM_BODY (body with the
# single emitter-inserted blank separator stripped). Returns 1 if there is no
# well-formed leading "---\n...\n---" block.
split_fm() {
    local file="$1" close
    [[ "$(head -n1 "$file")" == "---" ]] || return 1
    close="$(awk 'NR>1 && $0=="---"{print NR; exit}' "$file")"
    [[ -n "$close" ]] || return 1
    FM_BLOCK="$(sed -n "2,$((close-1))p" "$file")"
    FM_BODY="$(sed -n "$((close+1)),\$p" "$file")"
    FM_BODY="${FM_BODY#$'\n'}"   # drop the one blank line emit_doc inserts
}

# Print the scalar value of KEY from FM_BLOCK (empty if absent). Reads only
# "key: value" lines; structured/unknown keys are ignored, never misparsed.
fm_field() {
    local raw
    raw="$(printf '%s\n' "$FM_BLOCK" | sed -n "s/^$1: \{0,1\}//p" | head -n1)"
    # Inverse of _yaml_scalar: unwrap a double-quoted scalar and unescape.
    if [[ "$raw" == '"'*'"' && "${#raw}" -ge 2 ]]; then
        raw="${raw#\"}"; raw="${raw%\"}"
        raw="${raw//\\\"/\"}"; raw="${raw//\\\\/\\}"
    fi
    printf '%s' "$raw"
}

_lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# Print an ordered, bounded TOC for a knowledge/workbench directory.
# One line per doc: "<slug> [<type>] - <description|title|(no description)>".
# Ordered by lowercased type (untyped last) then slug; capped at <max> with a
# "... K more (raise --max)" notice when truncated. Skips INDEX.md/index.md.
render_section() {
    local dir="$1" max="$2"
    [[ -d "$dir" ]] || return 0
    local rows=() f base slug ty de ti desc render tkey
    shopt -s nullglob
    for f in "$dir"/*.md; do
        base="$(basename "$f")"
        [[ "$(_lower "$base")" == "index.md" ]] && continue
        slug="${base%.md}"
        split_fm "$f" || FM_BLOCK=""
        ty="$(fm_field type)"; de="$(fm_field description)"; ti="$(fm_field title)"
        desc="$de"; [[ -z "$desc" ]] && desc="$ti"; [[ -z "$desc" ]] && desc="(no description)"
        render="$slug"
        [[ -n "$ty" ]] && render="$render [$ty]"
        render="$render - $desc"
        tkey="$(_lower "$ty")"; [[ -z "$tkey" ]] && tkey="~~~"
        rows+=("$tkey"$'\t'"$slug"$'\t'"$render")
    done
    shopt -u nullglob
    (( ${#rows[@]} )) || return 0

    local total="${#rows[@]}"
    # awk caps to <max> rows and strips the two sort-key columns (equivalent to
    # `cut -f3-`). It reads all input rather than closing the pipe early like
    # `head`, so the upstream printf never takes SIGPIPE (which under
    # `set -o pipefail` would abort mid-output on a large index).
    printf '%s\n' "${rows[@]}" | LC_ALL=C sort -t$'\t' -k1,1 -k2,2 \
        | awk -F'\t' -v m="$max" 'NR<=m { sub(/^[^\t]*\t[^\t]*\t/, ""); print }'
    if (( total > max )); then
        printf '... %d more (raise --max)\n' "$(( total - max ))"
    fi
}

# Walk up from cwd looking for nearest ancestor with .work/. Only searches
# within $HOME; refuses to walk outside (e.g., into /var or /tmp) where a
# stray .work/ would not be the user's intended local store.
find_local_store() {
    local d
    d="$(pwd -P)"
    # Require cwd to be inside $HOME (resolved). If not, no local store.
    local home_real
    home_real="$(cd "$HOME" 2>/dev/null && pwd -P)" || return 1
    case "$d/" in
        "$home_real"/*) : ;;
        "$home_real/") return 1 ;;  # cwd == $HOME: no ancestor to search
        *) return 1 ;;
    esac
    while [[ "$d" != "/" && "$d" != "$home_real" ]]; do
        if [[ -d "$d/.work" ]]; then echo "$d/.work"; return 0; fi
        d="$(dirname "$d")"
    done
    return 1
}

resolve_workspace() {
    local explicit_ws="$1"
    if [[ -n "$explicit_ws" ]]; then
        local global="$HOME/.work/workspaces/$explicit_ws"
        [[ -d "$global" ]] || die "workspace '$explicit_ws' not found"
        echo "$global"; return 0
    fi
    local local_root
    if local_root="$(find_local_store 2>/dev/null)"; then
        echo "$local_root"; return 0
    fi
    # Global scan: find workspaces with any .active.* pointer.
    local matches=()
    if [[ -d "$HOME/.work/workspaces" ]]; then
        while IFS= read -r -d '' ws; do
            shopt -s nullglob
            local actives=("$ws"/.active.*)
            shopt -u nullglob
            if (( ${#actives[@]} > 0 )); then
                matches+=("$ws")
            fi
        done < <(find "$HOME/.work/workspaces" -mindepth 1 -maxdepth 1 -type d -print0)
    fi
    case "${#matches[@]}" in
        0) die "no workspace context; pass --workspace <ws>" ;;
        1) echo "${matches[0]}" ;;
        *)
            local names=()
            for m in "${matches[@]}"; do names+=("$(basename "$m")"); done
            die "multiple active workspaces (${names[*]}); pass --workspace <ws>"
            ;;
    esac
}

resolve_session() {
    local ws_root="$1" explicit_sess="$2"
    if [[ -n "$explicit_sess" ]]; then
        [[ -d "$ws_root/sessions/$explicit_sess" ]] || \
            die "session '$explicit_sess' not found in workspace '$(basename "$ws_root")'"
        echo "$explicit_sess"; return 0
    fi
    local sessions=()
    shopt -s nullglob
    for f in "$ws_root"/.active.*; do
        sessions+=("$(cat "$f")")
    done
    shopt -u nullglob
    if (( ${#sessions[@]} == 0 )); then
        die "no active session in '$(basename "$ws_root")'; pass --session <sess>"
    fi
    local unique
    unique="$(printf '%s\n' "${sessions[@]}" | sort -u)"
    local count
    count="$(printf '%s\n' "$unique" | wc -l)"
    if (( count == 1 )); then
        printf '%s' "$unique"
    else
        die "multiple sessions active in '$(basename "$ws_root")'; pass --session <sess>"
    fi
}

read_body() {
    local body_text="$1" body_from="$2"
    if [[ -n "$body_text" ]]; then printf '%s' "$body_text"; return 0; fi
    if [[ -n "$body_from" ]]; then
        if [[ "$body_from" == "-" ]]; then cat; else cat "$body_from"; fi
        return 0
    fi
    if [[ ! -t 0 ]]; then cat; return 0; fi
    printf ''
}

cmd_new() {
    local kind="$1"; shift
    [[ "$kind" == "knowledge" || "$kind" == "workbench" ]] || \
        die "kind must be 'knowledge' or 'workbench'" 2
    parse_flags "$@"
    [[ -n "$SLUG" ]] || usage
    validate_slug "$SLUG"

    F_AUTHOR="$(resolve_author)"
    local path
    resolve_path "$kind"; path="$RESOLVED_PATH"
    [[ -f "$path" ]] && die "$path already exists"

    F_TITLE="$TITLE_FLAG"; F_TYPE="$TYPE_FLAG"; F_DESC="$DESC_FLAG"
    F_CREATED="$(today)"; F_UPDATED="$F_CREATED"
    F_BODY="$(read_body "$BODY_TEXT" "$BODY_FROM")"

    emit_doc "$path"
    sync_after "new" "$kind" "$SLUG"

    if (( OPEN_FLAG )); then exec "${EDITOR:-vi}" "$path"; fi
}

cmd_update() {
    local kind="$1"; shift
    [[ "$kind" == "knowledge" || "$kind" == "workbench" ]] || \
        die "kind must be 'knowledge' or 'workbench'" 2
    parse_flags "$@"
    [[ -n "$SLUG" ]] || usage
    validate_slug "$SLUG"

    local path
    resolve_path "$kind"; path="$RESOLVED_PATH"
    [[ -f "$path" ]] || die "$path not found"
    split_fm "$path" || die "$path has malformed frontmatter"

    local ex_title ex_type ex_desc ex_author ex_created
    ex_title="$(fm_field title)"; ex_type="$(fm_field type)"
    ex_desc="$(fm_field description)"; ex_author="$(fm_field author)"
    ex_created="$(fm_field created)"

    if (( TITLE_SET )); then F_TITLE="$TITLE_FLAG"; else F_TITLE="$ex_title"; fi
    if (( TYPE_SET )); then F_TYPE="$TYPE_FLAG"; else F_TYPE="$ex_type"; fi
    if (( DESC_SET )); then F_DESC="$DESC_FLAG"; else F_DESC="$ex_desc"; fi
    if (( AUTHOR_SET )); then
        [[ "$AUTHOR_FLAG" == "human" || "$AUTHOR_FLAG" == "agent" ]] || \
            die "author must be 'human' or 'agent'"
        F_AUTHOR="$AUTHOR_FLAG"
    else
        F_AUTHOR="${ex_author:-$WORK_KB_AUTHOR_DEFAULT}"
    fi
    F_CREATED="${ex_created:-$(today)}"
    F_UPDATED="$(today)"

    # update replaces the body only when a body source is explicitly given;
    # bare stdin is NOT auto-consumed here (that would break the pure-touch case).
    if (( BODY_SET )); then
        F_BODY="$(read_body "$BODY_TEXT" "$BODY_FROM")"
    else
        F_BODY="$FM_BODY"
    fi

    emit_doc "$path"
    sync_after "update" "$kind" "$SLUG"

    if (( OPEN_FLAG )); then exec "${EDITOR:-vi}" "$path"; fi
}

cmd_index() {
    local ws_flag="" sess_flag="" max=100 write=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --workspace) ws_flag="$2"; shift 2 ;;
            --session)   sess_flag="$2"; shift 2 ;;
            --max)       max="$2"; shift 2 ;;
            --write)     write=1; shift ;;
            -*) die "unknown flag: $1" 2 ;;
            *)  die "extra argument: $1" 2 ;;
        esac
    done
    [[ "$max" =~ ^[0-9]+$ ]] || die "--max must be a non-negative integer"

    local ws_root kdir
    ws_root="$(resolve_workspace "$ws_flag")"
    kdir="$ws_root/knowledge"

    if (( write )); then
        mkdir -p "$kdir"
        {
            printf '%s\n' '<!-- generated by work-kb index; do not edit. regenerate with: work-kb index --write -->'
            printf '# Knowledge index\n\n'
            printf '## knowledge\n'
            render_section "$kdir" "$max"
        } > "$kdir/INDEX.md"
        printf '%s\n' "$kdir/INDEX.md"
        sync_after "index" "knowledge" "INDEX"
        return 0
    fi

    printf '## knowledge\n'
    render_section "$kdir" "$max"

    local sess=""
    if [[ -n "$sess_flag" ]]; then
        sess="$(resolve_session "$ws_root" "$sess_flag")"
    else
        # resolve_session die()s (exit) when no session resolves; that exit kills
        # the $(...) subshell, so the guard must be on the assignment (|| here),
        # not an inner `|| true` which never runs after exit.
        sess="$(resolve_session "$ws_root" "" 2>/dev/null)" || sess=""
    fi
    if [[ -n "$sess" ]]; then
        local wdir="$ws_root/sessions/$sess/workbench"
        if [[ -d "$wdir" ]]; then
            printf '\n## workbench (%s)\n' "$sess"
            render_section "$wdir" "$max"
        fi
    fi
}

# True if the configured python interpreter runs at all. The extractor itself
# degrades per-input (SQL and JSON need no PyYAML; YAML inputs warn+skip when
# PyYAML is absent), so we do NOT gate on `import yaml` here.
_ingest_python_ok() {
    "${WORK_KB_PYTHON:-python3}" -c '' >/dev/null 2>&1
}

# Portable base64 decode of $1: GNU uses -d, BSD/macOS uses -D.
_b64_decode() {
    printf '%s' "$1" | base64 -d 2>/dev/null || printf '%s' "$1" | base64 -D
}

# Print fuzzy artifacts (needing agent judgment) under $1 as worklist lines.
_ingest_worklist() {
    local src="$1" f
    while IFS= read -r f; do printf '%s - Prisma schema\n' "$f"; done \
        < <(find "$src" \( -name .git -o -name node_modules -o -name .work \) -prune -o -type f -name '*.prisma' -print 2>/dev/null)
    while IFS= read -r f; do
        if grep -qE '^##[[:space:]]+(API|Schema)\b' "$f" 2>/dev/null; then
            printf '%s - has ## API/## Schema section\n' "$f"
        fi
    done < <(find "$src" \( -name .git -o -name node_modules -o -name .work \) -prune -o -type f -iname 'readme*.md' -print 2>/dev/null)
    while IFS= read -r f; do printf '%s - runbook\n' "$f"; done \
        < <(find "$src" \( -name .git -o -name node_modules -o -name .work \) -prune -o -type f -iname 'runbook*' -print 2>/dev/null)
}

# Print structured artifact paths (openapi/swagger + *.sql) under $1, honoring --only.
_ingest_structured() {
    local src="$1" only="$2"
    if [[ "$only" != "sql" ]]; then
        find "$src" \( -name .git -o -name node_modules -o -name .work \) -prune -o -type f \
            \( -iname 'openapi*.y*ml' -o -iname 'openapi*.json' -o -iname 'swagger*.y*ml' -o -iname 'swagger*.json' \) -print 2>/dev/null
    fi
    if [[ "$only" != "openapi" ]]; then
        find "$src" \( -name .git -o -name node_modules -o -name .work \) -prune -o -type f -name '*.sql' -print 2>/dev/null
    fi
}

# Render the create/skipped sections and, when writing, emit docs via emit_doc.
# Args: kdir write max <record-line>...
_ingest_apply() {
    local kdir="$1" write="$2" max="$3"; shift 3
    local create_lines=() skip_lines=()
    local line slug type title desc links source body_b64
    local count=0 overflow=0 target body l larr
    local now; now="$(today)"

    for line in "$@"; do
        IFS=$'\x1f' read -r slug type title desc links source body_b64 <<<"$line"
        # Defense-in-depth: the ingest write path must honor the same slug
        # contract as new/update (never write outside knowledge/ or clobber via
        # a crafted slug). Skip, do not abort, on a bad slug.
        if [[ ! "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
            printf 'warn: skipping record with invalid slug: %q\n' "$slug" >&2
            continue
        fi
        target="$kdir/$slug.md"
        if [[ -f "$target" ]]; then
            skip_lines+=("$slug [$type] - $desc  <- $source")
            continue
        fi
        if (( count >= max )); then
            overflow=$((overflow + 1))
            continue
        fi
        count=$((count + 1))
        create_lines+=("$slug [$type] - $desc  <- $source")
        if (( write )); then
            body="$(_b64_decode "$body_b64")"
            if [[ -n "$links" ]]; then
                body+=$'\n\n## Related\n'
                IFS=',' read -ra larr <<<"$links"
                for l in "${larr[@]}"; do body+=$'\n'"- [[knowledge/$l]]"; done
            fi
            F_TITLE="$title"; F_TYPE="$type"; F_DESC="$desc"
            F_AUTHOR="agent"; F_CREATED="$now"; F_UPDATED="$now"; F_BODY="$body"
            emit_doc "$target" >/dev/null
        fi
    done

    printf '## would create (deterministic)\n'
    local x
    for x in "${create_lines[@]+"${create_lines[@]}"}"; do printf '%s\n' "$x"; done
    if (( overflow > 0 )); then printf '... %d more (raise --max)\n' "$overflow"; fi
    if (( ${#skip_lines[@]} > 0 )); then
        printf '\n## skipped (exists)\n'
        for x in "${skip_lines[@]}"; do printf '%s\n' "$x"; done
    fi
    if (( write )) && (( count > 0 )); then
        sync_after "ingest" "knowledge" "$count docs"
    fi
}

cmd_ingest() {
    local src="." ws_flag="" write=0 only="" max=100
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --from)      src="$2"; shift 2 ;;
            --workspace) ws_flag="$2"; shift 2 ;;
            --write)     write=1; shift ;;
            --only)      only="$2"; shift 2 ;;
            --max)       max="$2"; shift 2 ;;
            -*) die "unknown flag: $1" 2 ;;
            *)  die "extra argument: $1" 2 ;;
        esac
    done
    [[ -d "$src" ]] || die "--from path not found: $src"
    [[ "$max" =~ ^[0-9]+$ ]] || die "--max must be a non-negative integer"
    [[ -z "$only" || "$only" == "openapi" || "$only" == "sql" ]] || die "--only must be openapi or sql" 2

    local ws_root kdir
    ws_root="$(resolve_workspace "$ws_flag")"
    kdir="$ws_root/knowledge"

    # Collect structured files and (if python usable) extract records.
    local structured=() records=() f
    while IFS= read -r f; do [[ -n "$f" ]] && structured+=("$f"); done < <(_ingest_structured "$src" "$only")

    local py_ok=0 warnfile=""
    if (( ${#structured[@]} > 0 )) && _ingest_python_ok; then
        py_ok=1
        warnfile="$(mktemp "${TMPDIR:-/tmp}/work-kb-ingest-XXXXXX")"
        while IFS= read -r f; do [[ -n "$f" ]] && records+=("$f"); done \
            < <("${WORK_KB_PYTHON:-python3}" "$KB_LIB/ingest_extract.py" "${structured[@]}" 2>"$warnfile")
    fi

    # Sort records by type then slug (fields 2 then 1). Records are US-delimited
    # (\x1f) so empty fields (e.g. no links) survive; see ingest_extract.py.
    if (( ${#records[@]} > 0 )); then
        local sorted=()
        while IFS= read -r f; do sorted+=("$f"); done \
            < <(printf '%s\n' "${records[@]}" | LC_ALL=C sort -t$'\x1f' -k2,2 -k1,1)
        records=("${sorted[@]}")
    fi

    _ingest_apply "$kdir" "$write" "$max" "${records[@]+"${records[@]}"}"

    # Agent worklist: fuzzy artifacts always; structured too if the helper was unusable.
    printf '\n## agent worklist (needs judgment)\n'
    _ingest_worklist "$src"
    if (( py_ok == 0 )) && (( ${#structured[@]} > 0 )); then
        for f in "${structured[@]}"; do printf '%s - structured (extractor unavailable)\n' "$f"; done
    fi

    # Surface extractor diagnostics (parse failures, skipped/unbalanced files,
    # duplicate-slug drops) instead of swallowing them.
    if [[ -n "$warnfile" && -s "$warnfile" ]]; then
        printf '\n## warnings\n'
        cat "$warnfile"
    fi
    [[ -n "$warnfile" ]] && rm -f "$warnfile"
    return 0
}

[[ $# -ge 1 ]] || usage
case "$1" in
    new)    shift; [[ $# -ge 1 ]] || usage; cmd_new "$@" ;;
    update) shift; [[ $# -ge 1 ]] || usage; cmd_update "$@" ;;
    index)  shift; cmd_index "$@" ;;
    ingest) shift; cmd_ingest "$@" ;;
    -h|--help) usage ;;
    *) die "unknown subcommand: $1" 2 ;;
esac
