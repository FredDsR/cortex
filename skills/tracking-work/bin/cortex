#!/usr/bin/env bash
# cortex: unified front door for the tracking-work skill family.
# Dispatches to the per-skill scripts (kb, viz). See skills/*/SKILL.md.
set -euo pipefail

usage() {
    cat >&2 <<'EOF'
Usage:
  cortex kb  <command> [args...]   Author/query knowledge & workbench docs
                                    (new, update, index, ingest)
  cortex viz <command> [args...]   Visualize the work tree (build, serve)

Run `cortex kb --help` or `cortex viz --help` for group-specific help.
EOF
    exit "${1:-2}"
}

# Portable realpath: resolve symlinks without readlink -f (BSD/macOS lacks it).
_resolve() {
    local p="$1" t
    while [ -L "$p" ]; do
        t="$(readlink "$p")"
        case "$t" in
            /*) p="$t" ;;
            *)  p="$(cd "$(dirname "$p")" && cd "$(dirname "$t")" && pwd)/$(basename "$t")" ;;
        esac
    done
    printf '%s' "$p"
}

self="$0"
case "$self" in
    */*) : ;;
    *)   self="$(command -v -- "$self")" ;;
esac
self="$(_resolve "$self")"
# bin/ -> tracking-work/ -> skills/ -> repo root
# Physical resolution (-P) so an invocation through a symlinked skill dir still
# lands at the real repo root, where the top-level `cortex/` package lives.
REPO_ROOT="$(cd -P "$(dirname "$self")/../../.." && pwd -P)"
VIZ_BIN="$REPO_ROOT/skills/tracking-work-viz/bin/work-viz"

_run() {  # $1 = target script, rest = args. Clear error if the script is missing.
    local bin="$1"; shift
    [[ -f "$bin" ]] || { echo "cortex: cannot find $(basename "$bin") at $bin (broken install?)" >&2; exit 1; }
    exec "$bin" "$@"
}

[[ $# -ge 1 ]] || usage
group="$1"; shift
case "$group" in
    kb)        exec env PYTHONPATH="$REPO_ROOT${PYTHONPATH:+:$PYTHONPATH}" \
                    "${WORK_KB_PYTHON:-python3}" -m cortex.cli kb "$@" ;;
    viz)       _run "$VIZ_BIN" "$@" ;;
    -h|--help) usage 0 ;;
    *) echo "cortex: unknown command '$group'" >&2; usage ;;
esac
